{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: start",
      "type": "npm",
      "script": "dev:frontend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*http.*"
        }
      }
    },
    {
      "label": "Backend: start",
      "type": "npm",
      "script": "dev:backend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": { "regexp": "^$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Uvicorn running.*",
          "endsPattern": ".*Application startup complete.*"
        }
      }
    },
    {
      "label": "Development: start both",
      "dependsOn": ["Frontend: start", "Backend: start"],
      "problemMatcher": []
    },
    {
      "label": "Checks: fast",
      "type": "npm",
      "script": "check",
      "problemMatcher": []
    },
    {
      "label": "Checks: full",
      "type": "npm",
      "script": "verify",
      "problemMatcher": []
    },
    {
      "label": "Format",
      "type": "npm",
      "script": "format",
      "problemMatcher": []
    },
    { "label": "Tests", "type": "npm", "script": "test", "problemMatcher": [] },
    {
      "label": "Build",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
